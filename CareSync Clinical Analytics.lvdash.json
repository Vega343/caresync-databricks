{
  "datasets": [
    {
      "name": "patient_360",
      "displayName": "Patient 360",
      "config": {
        "version": "1.1",
        "source": "caresyncdata.gold.patient_360",
        "dimensions": [
          {
            "name": "patient_id",
            "expr": "patient_id",
            "displayName": "Patient ID"
          },
          {
            "name": "first_name",
            "expr": "first_name",
            "displayName": "First Name"
          },
          {
            "name": "last_name",
            "expr": "last_name",
            "displayName": "Last Name"
          },
          {
            "name": "hospital_name",
            "expr": "hospital_name",
            "displayName": "Hospital Name"
          },
          {
            "name": "insurance_provider_name",
            "expr": "insurance_provider_name",
            "displayName": "Insurance Provider"
          },
          {
            "name": "gender",
            "expr": "gender",
            "displayName": "Gender"
          },
          {
            "name": "city",
            "expr": "city",
            "displayName": "City"
          },
          {
            "name": "state",
            "expr": "state",
            "displayName": "State"
          },
          {
            "name": "last_test_date",
            "expr": "last_test_date",
            "displayName": "Last Test Date"
          },
          {
            "name": "age",
            "expr": "age",
            "displayName": "Age"
          }
        ],
        "measures": [
          {
            "name": "total_tests",
            "expr": "SUM(total_tests)",
            "displayName": "Total Tests"
          },
          {
            "name": "critical_test_count",
            "expr": "SUM(critical_test_count)",
            "displayName": "Total Critical Tests"
          },
          {
            "name": "abnormal_test_count",
            "expr": "SUM(abnormal_test_count)",
            "displayName": "Total Abnormal Tests"
          },
          {
            "name": "unique_patients",
            "expr": "COUNT(DISTINCT patient_id)",
            "displayName": "Unique Patients"
          }
        ]
      }
    },
    {
      "name": "hospital_daily",
      "displayName": "Hospital Daily Summary",
      "config": {
        "version": "1.1",
        "source": "caresyncdata.gold.hospital_daily_summary",
        "dimensions": [
          {
            "name": "hospital_name",
            "expr": "hospital_name",
            "displayName": "Hospital Name"
          },
          {
            "name": "summary_date",
            "expr": "summary_date",
            "displayName": "Date"
          },
          {
            "name": "day_name",
            "expr": "day_name",
            "displayName": "Day of Week"
          },
          {
            "name": "is_weekend",
            "expr": "is_weekend",
            "displayName": "Is Weekend"
          }
        ],
        "measures": [
          {
            "name": "total_tests",
            "expr": "SUM(total_tests)",
            "displayName": "Total Tests",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "abnormal_rate_pct",
            "expr": "AVG(abnormal_rate_pct)",
            "displayName": "Avg Abnormal Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "critical_test_count",
            "expr": "SUM(critical_test_count)",
            "displayName": "Total Critical Tests",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "unique_patients_tested",
            "expr": "SUM(unique_patients_tested)",
            "displayName": "Unique Patients Tested",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "lab_trends",
      "displayName": "Lab Test Trends",
      "config": {
        "version": "1.1",
        "source": "caresyncdata.gold.lab_test_trends",
        "dimensions": [
          {
            "name": "test_name",
            "expr": "test_name",
            "displayName": "Test Name"
          },
          {
            "name": "year",
            "expr": "year",
            "displayName": "Year"
          },
          {
            "name": "month",
            "expr": "month",
            "displayName": "Month Number"
          },
          {
            "name": "month_name",
            "expr": "month_name",
            "displayName": "Month"
          },
          {
            "name": "quarter_name",
            "expr": "quarter_name",
            "displayName": "Quarter"
          },
          {
            "name": "year_month_date",
            "expr": "MAKE_DATE(year, month, 1)",
            "displayName": "Year Month"
          }
        ],
        "measures": [
          {
            "name": "total_tests",
            "expr": "SUM(total_tests)",
            "displayName": "Total Tests",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "abnormal_rate_pct",
            "expr": "AVG(abnormal_rate_pct)",
            "displayName": "Avg Abnormal Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "critical_test_count",
            "expr": "SUM(critical_test_count)",
            "displayName": "Total Critical Tests",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "abnormal_rate_change_pct",
            "expr": "AVG(abnormal_rate_change_pct)",
            "displayName": "Avg Abnormal Rate Change %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
